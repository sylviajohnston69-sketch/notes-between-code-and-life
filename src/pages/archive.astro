---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';
import { groupByYear } from '../lib/post-utils';

const posts = await getPublishedPosts();
const postsByYear = groupByYear(posts.map((post) => ({ ...post, date: post.data.date })));
---

<BaseLayout title="归档">
  <div class="shell">
    <h1>归档</h1>
    {
      [...postsByYear].map(([year, yearPosts]) => (
        <section aria-labelledby={`archive-${year}`}>
          <h2 id={`archive-${year}`}>{year}</h2>
          {yearPosts.map((post) => <PostCard post={post} />)}
        </section>
      ))
    }
  </div>
</BaseLayout>
